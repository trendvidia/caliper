manifesto {
  mission = "Caliper is a Go-only static-analysis and code-transformation engine that powers Steward's closed-source analysis pass. It exposes AST-level pattern matching, CFG/taint analysis, and rewrite tools via an MCP server interface."
  # Caliper's own rules (sql_injection, nil_deref, etc.) make it the ideal
  # subject for strict module hygiene — it should never accidentally pull in
  # a competing analysis framework.
  mission_drift_gate = true
  blocked_module_globs = [
    "golang.org/x/tools/go/analysis/passes/**",
    "honnef.co/go/tools/**",
    "github.com/golangci/golangci-lint/**"
  ]
  # upstream analysistest harness; Caliper has its own
  # staticcheck — we are the staticcheck
  # Caliper is perf-sensitive: LLM clients stream results and latency shows.
  max_perf_regression_percent = 5
  perf_significance_alpha = 0.05
}

domains = [
  {
    name = "engine"
    # Core AST/CFG/taint machinery — highest scrutiny.
    path_globs = [
      "internal/analysis/**",
      "internal/cfg/**",
      "internal/taint/**",
      "internal/pattern/**",
      "internal/transform/**",
    ]
    min_coverage = 85
    max_cyclomatic_complexity = 12
    approval_threshold = 300
    criticality_multiplier = 3.0
    restricted = false
  }
  {
    name = "mcp"
    # MCP server + 24 exposed tools — public API surface.
    path_globs = [
      "internal/mcp/**",
      "cmd/**",
    ]
    min_coverage = 75
    max_cyclomatic_complexity = 10
    approval_threshold = 200
    criticality_multiplier = 2.0
  }
  {
    name = "rules"
    # Bundled .gcl rule files; human-readable but affect every downstream user.
    path_globs = [
      "patterns/**",
      "rules/**",
      "**/*.gcl",
      "**/*.gsp",
    ]
    min_coverage = 0       # not Go code, no coverage gate
    approval_threshold = 200
    criticality_multiplier = 2.0
    restricted = false
    # Structural pattern-match rules are pure data; SARIF analysis isn't applicable.
    ignored_sarif_rules = ["SA1000", "SA4006"]
  }
  {
    name = "config"
    # .caliper.pxf schema, PXF loader, options wiring.
    path_globs = [
      "internal/config/**",
      "**/*.pxf",
    ]
    min_coverage = 70
    max_cyclomatic_complexity = 8
    approval_threshold = 150
    criticality_multiplier = 1.5
  }
  {
    name = "proto"
    # Protobuf definitions (including protowire private dep). Changes here
    # ripple into generated code across services.
    path_globs = [
      "proto/**",
      "**/*.proto",
      "gen/**",
    ]
    min_coverage = 0       # generated code excluded from coverage accounting
    restricted = true
    supermajority_ratio = 1.0
    criticality_multiplier = 3.0
  }
  {
    name = "infra"
    # CI, release scripts, Homebrew tap config, Makefile.
    path_globs = [
      ".github/**",
      "scripts/**",
      "Makefile",
      "*.yaml",
      "*.yml",
      ".goreleaser*",
    ]
    restricted = true
    supermajority_ratio = 0.75
    criticality_multiplier = 2.0
  }
  {
    name = "docs"
    path_globs = [
      "docs/**",
      "**/*.md",
      "README*",
    ]
    min_coverage = 0
    criticality_multiplier = 0.5
  }
  {
    # Safety net — anything not matched above still gets basic gates.
    name = "other"
    path_globs = ["**"]
    min_coverage = 60
    max_cyclomatic_complexity = 15
    criticality_multiplier = 1.0
  }
]

# Private repo with a small, fixed engineering team; escrow/sandbox flow
# is not applicable.
escrow {
}

decay {
  # 6-month half-life suits a small private team shipping continuously.
  # Fast enough to re-center on current contributors; slow enough that a
  # two-week vacation doesn't crater your vote weight.
  half_life = 180d
  base_points = 100
}

immune_system {
  # MIT-licensed; keep the dependency graph clean and permissive.
  allowed_licenses = ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"]

  # Caliper itself enforces pinning discipline downstream; hold it to the
  # same standard.
  require_pinned_dependencies = true

  anomaly_quarantine {
    # A large doc-heavy diff that also touches engine code is suspicious.
    documentation_concentration = 0.75

    # Engine internals, proto schema, and CI release config are the highest-
    # value targets for supply-chain attacks.
    sensitive_path_globs = [
      "internal/taint/**",
      "internal/analysis/**",
      "proto/**",
      ".github/workflows/**",
      "scripts/release*",
      ".goreleaser*",
    ]

    # 24-hour cooling period before any sensitive-path PR can land.
    timelock = "24h"
  }
}

amendments {
  # Two-thirds supermajority among the top-5 reputation holders.
  supermajority_ratio = 0.66
  top_n_holders = 5
  voting_period = "120h"   # 5 days — long enough for async review across time zones
  amendment_path_globs = [
    ".steward/governance.pxf",
    "CODEOWNERS",
  ]
}

# Caliper powers an on-call analysis service; contributors own the bugs
# they ship. Slashing is enabled with moderate parameters calibrated for
# an internal team.
slashing {
  enabled = true
  base_points = 75
  growth_half_life = "45d"   # penalty doubles roughly every 6 weeks
  max_multiplier = 6.0       # cap at 6× for ancient latent bugs
}

founders = [
  {
    # Replace with the actual GitHub handle(s) of Caliper's initial authors.
    # Each domain listed here must match a name in the domains section above.
    handle = "trendvidia-bot"
    reputation_seed = {
      "engine" = 1500
      "mcp"    = 1200
      "rules"  = 1000
      "config" = 800
      "proto"  = 1000
      "infra"  = 800
      "docs"   = 500
    }
  }
]

alternatives {
  enabled = true
  groups = [
    {
      name = "go-analysis-framework"
      modules = [
        "honnef.co/go/tools/analysis",
        "golang.org/x/tools/go/analysis",
        "github.com/golangci/golangci-lint/pkg/golinters"
      ]
    },
    {
      name = "logger"
      modules = [
        "github.com/sirupsen/logrus",
        "go.uber.org/zap",
        "github.com/rs/zerolog",
        "log/slog"
      ]
    },
    {
      name = "config-loader"
      modules = [
        "github.com/spf13/viper",
        "github.com/kelseyhightower/envconfig",
        "github.com/caarlos0/env/v6"
      ]
    }
  ]
  behavioral {
    # Conservative threshold: Caliper's internal API is dense with common
    # method names; too-low threshold produces noise.
    jaccard_threshold = 0.4
    max_pairs = 15
    extra_stopwords = [
      "Visit",
      "Walk",
      "Inspect",
      "Match",
      "Bind",
      "Apply",
      "Pos",
      "End",
      "Type"
    ]
  }
}

sarif {
  # Caliper emits SARIF itself; also consume SARIF from CI linters (staticvet,
  # govulncheck, etc.) to gate its own PRs under the same framework.
  enabled = true
  artifact_glob = "*.sarif"
}

precedent {
  # Issue volume is low (private repo); jaccard is sufficient and requires no
  # external API keys.
  backend = "jaccard"
  threshold = 0.45
  candidate_limit = 50
}

triage {
  # Deterministic triage is adequate for a small private issue tracker.
  backend = "deterministic"
  high_priority_min = 2.0   # engine/proto domain criticality must be ≥ 2× to auto-escalate
  medium_priority_min = 1.0
}

caliper {
  # Caliper governs itself. All default rules apply; override to a focused
  # set avoids infinite-regress noise from its own meta-analysis.
  enabled = true
  rules = [
    "nil_deref",
    "resource_leak",
    "race_condition",
    "sql_injection",
    "taint_flow",
    "goroutine_leak",
    "error_swallow",
    "lock_violation",
  ]
}